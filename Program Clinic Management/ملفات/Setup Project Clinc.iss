// Database
Source: "C:\Users\syrian technology\Desktop\My Project\مشروع تخرج Mohammad\Program Clinic Management\Program Clinic Management\bin\Release\ClinicSystemDB.mdf";DestDir: "{userdocs}\Clinic Management\Database"; Flags: onlyifdoesntexist
Source: "C:\Users\syrian technology\Desktop\My Project\مشروع تخرج Mohammad\Program Clinic Management\Program Clinic Management\bin\Release\ClinicSystemDB_log.ldf";DestDir: "{userdocs}\Clinic Management\Database"; Flags: onlyifdoesntexist

// LocalDB  ملف
Source: "C:\Users\syrian technology\Desktop\My Project\مشروع تخرج Mohammad\ملفات\SqlLocalDB.msi";DestDir: "{app}\Local"; Flags: ignoreversion


