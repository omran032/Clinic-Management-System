 ; ============================================================
; ===============  فحص وتثبيت LocalDB2025 ====================
; ============================================================
[Code]

// 1) فحص وجود الإنستانس LocalDB2025
function IsLocalDB2025Installed(): Boolean;
var
  ResultCode: Integer;
begin
  Result := Exec(
    'sqllocaldb',
    'info LocalDB2025',
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode
  ) and (ResultCode = 0);
end;

// 2) تشغيل ملف LocalDB للمستخدم عبر msiexec (مضمون 100%)
procedure InstallLocalDB2025();
var
  ResultCode: Integer;
begin
  MsgBox('يرجى إكمال تثبيت LocalDB 2025 في النافذة التي ستظهر الآن، ثم اضغط "Finish" عند الانتهاء.', mbInformation, MB_OK);

  Exec(
    'msiexec.exe',
    '/i "' + ExpandConstant('{app}\Local\SqlLocalDB.msi') + '"',
    '',
    SW_SHOW,
    ewWaitUntilTerminated,
    ResultCode
  );
end;

// 3) تنفيذ الفحص بعد انتهاء التثبيت بالكامل
procedure CurStepChanged(CurStep: TSetupStep);
var
  UserChoice: Integer;
begin
  if CurStep = ssPostInstall then
  begin
    if not IsLocalDB2025Installed() then
    begin
      UserChoice := MsgBox(
        'أحد المكوّنات الضرورية (SQL Server LocalDB 2025) غير موجود على جهازك.'#13#13 +
        'سيتم الآن فتح نافذة لتثبيت الأداة المطلوبة.'#13#13 +
        'هل تريد المتابعة؟',
        mbConfirmation, MB_YESNO);

      if UserChoice = IDNO then
      begin
        MsgBox('تعذّر متابعة التثبيت بسبب نقص أحد المكوّنات الأساسية اللازمة لتشغيل البرنامج.',
               mbError, MB_OK);
        Exit;
      end;

      InstallLocalDB2025();
    end;
  end;
end;

 
 
 
 
 
 
 
 
 
 